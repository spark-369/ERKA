# ===========================================================================
# Enterprise RAG Knowledge Assistant - BACKEND CONFIGURATION
#
# Requires two running services:
#   * PostgreSQL  (DATABASE_URL below)
#   * Redis       (REDIS_URL below) - cache, rate limits, Celery broker
#
# Model inference defaults to the offline stub/hash providers so nothing is
# downloaded; switch them to `transformers` + `huggingface` for real answers.
#
# NOTE: list-typed settings (CORS_ORIGINS, ALLOWED_EXTENSIONS) must be valid
# JSON arrays because they are parsed by pydantic-settings.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Enterprise RAG Knowledge Assistant"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Public origin of the frontend, used for CORS + SSE headers.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-with-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=rag-knowledge-assistant
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Manual rate limiting (custom sliding-window implementation, no 3rd-party)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Stricter scopes: authentication, chat generation, document upload.
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_CHAT_REQUESTS=20
RATE_LIMIT_UPLOAD_REQUESTS=10

# ---------------------------------------------------------------------------
# Relational storage - PostgreSQL (required; there is no SQLite fallback)
#
# The default points at a PostgreSQL server on the local machine. If you run
# PostgreSQL in Docker instead, use `postgres` as the host:
#   postgresql+psycopg2://rag:rag@postgres:5432/rag
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:mysecretpassword@localhost:5432/rag
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# ---------------------------------------------------------------------------
# Redis - cache, rate-limit counters, Celery broker/result backend
#
# The default points at a Redis server on the local machine. If you run Redis in
# Docker instead, use `redis` as the host:  redis://redis:6379/0
#
# DB 0 is the cache/broker. Rate-limit counters share it under the `ratelimit:*`
# key prefix, so a flush of the DB also resets rate limiting (by design).
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Leave empty to fall back to REDIS_URL (the normal case).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# false -> ingestion runs in a real Celery worker process consuming Redis.
#          WARNING: the embedded Chroma client keeps its ANN index in memory, so
#          a separate worker process is invisible to the API process's index and
#          retrieval returns nothing even though the vectors are stored. Use
#          this only when ingestion throughput matters more than being able to
#          chat about a document immediately after upload.
# true  -> tasks execute inline in the API process (no worker required). This is
#          the default: one process owns the collection, so a document is
#          searchable the moment ingestion finishes.
CELERY_TASK_ALWAYS_EAGER=true
CELERY_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Vector store - ChromaDB (embedded + persistent, no server required)
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_base

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=[".pdf",".txt",".md",".csv",".docx",".json",".html"]

# ---------------------------------------------------------------------------
# Embeddings
# huggingface -> sentence-transformers model (real semantic search)
# hash        -> deterministic lexical hash (no model download); it matches on
#                token overlap only, which hurts retrieval quality, so use it
#                for tests/CI only.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# ---------------------------------------------------------------------------
# Chunking / retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Number of chunks handed to the model as context (standard RAG default, k=4).
RETRIEVAL_TOP_K=4
RETRIEVAL_FETCH_K=20
# Minimum similarity for a chunk to be used. 0.0 keeps every retrieved chunk so
# no document is silently dropped; raise it when using semantic embeddings
# (EMBEDDING_PROVIDER=huggingface). The offline `hash` embedder produces weak
# lexical scores, so a positive threshold can filter out an entire document.
RETRIEVAL_SCORE_THRESHOLD=0.0

# ---------------------------------------------------------------------------
# LLM inference layer
# transformers -> Qwen2.5-0.5B-Instruct via Hugging Face transformers
# stub         -> deterministic offline extractor (NO real language model;
#                 it only quotes retrieved chunks back, so replies read
#                 mechanically). Use it for tests/CI, never for real answers.
#
# Weights download on first use into HF_HOME (./data/hf by default). Requires
# `transformers` + `torch` (see requirements.txt).
# ---------------------------------------------------------------------------
LLM_PROVIDER=transformers
LLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# Longest answer the model may generate, in tokens. 8192 is the full generation
# length Qwen2.5 was trained for, so this is the highest value that yields a
# coherent answer; anything beyond it degrades into repetition. The prompt
# (system + retrieved context + history) plus this value must stay within the
# model's 32768-token context window - the app trims the budget automatically
# when a long context leaves less room.
#
# NOTE: generating the full 8192 tokens on CPU takes several minutes (roughly
# 20-40 tokens/sec for a 0.5B model). Lower this to ~2048 for snappier replies.
LLM_MAX_NEW_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_DEVICE=cpu
LLM_TORCH_DTYPE=auto
# Structured output: constrain decoding to a JSON schema (outlines) so answers
# come back as a validated object with explicit citations. Requires the
# `outlines` package; automatically falls back to plain text when it is missing.
LLM_STRUCTURED_OUTPUT=true
LLM_TRUST_REMOTE_CODE=false
# Run generation through Celery instead of inline (POST /chat/completions).
CHAT_USE_CELERY=false
HF_HOME=./data/hf
